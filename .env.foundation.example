# Copy to .env.foundation.local only after the isolated backend exists.
# No hosted development project has been configured. Never copy production keys.
VITE_ORDO_ARCHITECTURE=foundation
VITE_ORDO_ENVIRONMENT=development
VITE_APP_URL=http://127.0.0.1:5182
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
FOUNDATION_TARGET=foundation-local
FOUNDATION_PROJECT_REF=local
FOUNDATION_DB_HOST=127.0.0.1
FOUNDATION_DB_PORT=54322
# The safety CLI requires explicit arguments; it does not load this file or use
# existing .env, linked Supabase state, DATABASE_URL or production configuration.
