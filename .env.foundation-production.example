# Copy to .env.foundation-production.local only after creating and verifying a new Ordo-owned project.
# Vite embeds VITE_ values in browser code. Never place service-role/secret keys here.
VITE_ORDO_ARCHITECTURE=foundation
VITE_ORDO_ENVIRONMENT=production
VITE_ORDO_TARGET_REF=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_URL=https://ordo.inspirarestudio.com
VITE_ENABLE_GOOGLE_AUTH=false
